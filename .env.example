# Desire System - 設定ファイルのサンプル
# このファイルをコピーして .env にリネームして使う
# cp .env.example .env

# キャラクターID（desire_config.json の読み込み先やDBパスの決定に使う）
CHARACTER_ID=petit

# 一緒にいる人の名前（miss_companion 欲求で呼びかける相手）
COMPANION_NAME=あなた

# データディレクトリ（m5-petit-app と共有。desire_config.json や desires.json の保存先）
# PETIT_DATA_DIR=~/petit_data

# memory-mcp が使う SQLite DB のパス（キーワード検索に使う）
# MEMORY_DB_PATH=~/.claude/memories/<character_id>/memory.db

# desires.json の出力先（未指定なら PETIT_DATA_DIR 配下に自動生成）
# DESIRES_PATH=~/petit_data/characters/<character_id>/data/desires.json
